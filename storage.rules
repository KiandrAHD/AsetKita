rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/avatar/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId && request.auth.token.demo != true;
      allow write: if request.auth != null && request.auth.uid == userId && request.auth.token.demo != true
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
